<?xml version="1.0" encoding="utf-8"?>
<!-- Selector de fondo propio: fotos de la TV, de memorias USB y las mandadas desde el PC. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wallpaperOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2080A0E"
    android:clickable="true"
    android:focusable="false"
    android:paddingStart="48dp"
    android:paddingTop="28dp"
    android:paddingEnd="48dp"
    android:paddingBottom="16dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnWallPickClose"
                style="@style/TopButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="0dp"
                android:gravity="center"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="←"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 600"
                android:text="Elige un fondo"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/wallPickInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="58dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/outfit"
            android:text="Buscando fotos…"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/wallGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="6dp"
                android:paddingBottom="24dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/wallEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:fontFamily="@font/outfit"
                android:lineSpacingMultiplier="1.3"
                android:text="No encontré fotos.\n\nConecta una memoria USB con imágenes (JPG, PNG, WEBP o HEIC)\no mándalas desde el PC con tools\\poner-fondo.ps1."
                android:textColor="#CCFFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
