<?xml version="1.0" encoding="utf-8"?>
<!-- Menu rapido: se abre con el boton de engranaje del control (KEYCODE_NOTIFICATION / KEYCODE_SETTINGS). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quickOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quick_scrim"
    android:clickable="true"
    android:focusable="false"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/quickPanel"
        android:layout_width="440dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/glass_panel"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/quickClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 300"
            android:includeFontPadding="false"
            android:text="12:00"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/quickSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"
            android:fontFamily="@font/outfit"
            android:text="Menú rápido"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/quickItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/outfit"
            android:gravity="center"
            android:text="⚙️ o Atrás para cerrar"
            android:textColor="#66FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
